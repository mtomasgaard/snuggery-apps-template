o.zip/content"}}, {"id": "5e56777c-ca53-4d14-8555-7a8c846a8a2e", "key": "scotese_solara_tas.zip", "size": 307205041, "checksum": "md5:1d8fcd0fff6d7a2bee5f9bde9f071524", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_solara_tas.zip/content"}}, {"id": "0d93af6b-a8b4-4f39-8db9-52207859f70a", "key": "scotese_06_tas.zip", "size": 300365387, "checksum": "md5:a925621373aa7268bd9b9cbbb03287fd", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_06_tas.zip/content"}}, {"id": "013ec8e7-557e-41a7-88b2-0b1c39ef23eb", "key": "scotese_07_tas.zip", "size": 300384517, "checksum": "md5:575721a5f52eb1705b10e147a9e7fa51", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_07_tas.zip/content"}}, {"id": "de3a9825-8ae5-44ae-aef7-8f29cac1f580", "key": "scotese_02_tos.zip", "size": 290930334, "checksum": "md5:90143a3c6a6966aa9cbfe821d8675cd5", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_02_tos.zip/content"}}, {"id": "b6052bc0-2538-497f-b2c6-ab49c01bb9f2", "key": "scotese_2co2a_tas.zip", "size": 305546696, "checksum": "md5:cf0795efd09bbe907dbc74c1b54f6c88", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_2co2a_tas.zip/content"}}, {"id": "831bad97-8f43-45eb-b7c0-ef01e59fd1de", "key": "scotese_2co2a_tos.zip", "size": 291682425, "checksum": "md5:9830ffdec395f766185201d01fd3a0cb", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_2co2a_tos.zip/content"}}, {"id": "39006f87-dda7-403d-9a13-15f00e16052e", "key": "scotese_4co2a_pr.zip", "size": 515256219, "checksum": "md5:5712d0601dc85b338f93e164c722f492", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_4co2a_pr.zip/content"}}, {"id": "c018fed5-1773-421b-9640-12f74eba91bf", "key": "scotese_spinupa_tos.zip", "size": 292279430, "checksum": "md5:fd1b5eb45fd0ef46fe70412bbb1a4efb", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_spinupa_tos.zip/content"}}, {"id": "ee410c56-e7e4-4ded-9cf7-88470ca39f54", "key": "scotese_06_tos.zip", "size": 286803655, "checksum": "md5:357e567f9f6071a40ebf622b7544fddf", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_06_tos.zip/content"}}, {"id": "549a40f2-ec00-4125-a408-8a2c50f0b286", "key": "scotese_02_so.zip", "size": 320510908, "checksum": "md5:af92fa7616a64bd76a5c3aa6327038ea", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_02_so.zip/content"}}, {"id": "e380587d-befa-4ec6-9f7a-1b5b4f3612b4", "key": "scotese_07_pr.zip", "size": 513591309, "checksum": "md5:7094ba86559f2c696ec6fe1fecdc8931", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_07_pr.zip/content"}}, {"id": "7a518aeb-5441-43ca-9162-149dff56bf2a", "key": "scotese_4co2a_so.zip", "size": 319046100, "checksum": "md5:8c5eab46304c60c02edfd26b0c0d21cc", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_4co2a_so.zip/content"}}, {"id": "9e0c3a52-8c53-4ad0-b802-0cd96373821a", "key": "scotese_08_pr.zip", "size": 513688676, "checksum": "md5:9e0bc4798a02753161e3fe7843a4ec36", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_08_pr.zip/content"}}, {"id": "43c465a2-11a3-45d9-b90c-c8041ca54fea", "key": "scotese_02_tas.zip", "size": 304593710, "checksum": "md5:5dc5fb031d6840b22c29a52158991f73", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_02_tas.zip/content"}}, {"id": "291dc898-e273-4222-9d59-9c0818d38701", "key": "scotese_4co2a_tas.zip", "size": 304453588, "checksum": "md5:92c34bacffc519f173b0b9c22d7f0be0", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_4co2a_tas.zip/content"}}, {"id": "67496a6b-e11a-4ff1-8dd9-24602476cab4", "key": "scotese_4co2a_tos.zip", "size": 290601752, "checksum": "md5:3d8e09e5320d6bdb5d40198f4ffb4b25", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_4co2a_tos.zip/content"}}, {"id": "e7234286-e6c4-404f-91cd-15d714b72319", "key": "ExperimentInfo.xlsx", "size": 25443, "checksum": "md5:0c61461d58ce3614a604d8dbe3636ad8", "links": {"self": "https://zenodo.org/api/records/8237751/files/ExperimentInfo.xlsx/content"}}, {"id": "800a756a-0f20-45b0-8c2b-5cb2d9dffcd1", "key": "scotese_02_pr.zip", "size": 515100776, "checksum": "md5:8c15488f422669aeba0a1a09e8a4b783", "links": {"self": "https://zenodo.org/api/records/8237751/files/scotese_02_pr.zip/content"}}], "swh": {}, "owners": [{"id": "399022"}], "status": "published", "stats": {"downloads": 6178, "unique_downloads": 5144, "views": 1683, "unique_views": 1552, "version_downloads": 6178, "version_unique_downloads": 5144, "version_unique_views": 1552, "version_views": 1683}, "state": "done", "submitted": true}